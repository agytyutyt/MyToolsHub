# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 打包产物（PyInstaller 中间件 / 输出）
build/
dist/
deploy/

# 离线部署组件（Chrome / LibreOffice 安装包，约 500MB，可随时重建，勿入库）
# 由 tools/fetch-offline-bundle.py 下载，清单见 tools/offline-components.json
runtime/

# 运行时日志与进程文件
logs/
.server.*
*.log
*.pid

# 离线组件安装器的自检日志（脚本同目录生成，用于目标机排障，不入库）
tools/offline-runtime/安装日志-*.txt

# 管理后台数据与加密密钥（含账号/密码/身份证/大模型密钥，勿提交）
config/admin.json
config/.admin_key

# 数据根目录备份指针（机器相关：含本机绝对路径，且是 get_data_root() 的兜底来源。
# 一旦入库，新机器克隆后会把数据根解析到原作者的用户目录，可能静默读写他人数据。
# 首启/改数据目录时程序会自动重写本文件。）
config/data_root.json

# 插件本地运行配置（含密钥，勿提交；无密钥的纯字段配置可按需跟踪）
plugins/character-graph/backend/config.json
plugins/case-report/backend/config.json
plugins/file-filter/backend/config.json
plugins/file-filter/config.json

# 插件运行期用户数据（规范 S-3：backend/data/ 一律不入库）
plugins/*/backend/data/

# 本地测试产物（xlsx_render / routes 自测脚本的输出目录）
plugins/knowledge-base/backend/out/

# 插件临时产物（轨迹转换视频任务缓存）
plugins/*/backend/.task_cache/

# 地图标点插件测试/演示产物（录制视频、模拟轨迹数据）
plugins/map-marker/frontend/*.mp4
plugins/map-marker/frontend/yunfu*.json
plugins/map-marker/frontend/yunfu*.txt
plugins/map-marker/frontend/simulate_yunfu_5min.py

# 编辑器
.vscode/
.idea/
*.swp
.DS_Store
# 环境变量
.env

# ZCode 会话工作目录（交接文档约定：不入库）
.zcode/

# 压缩算法评估基准语料与脚本（可随时重建，勿入库）
.bench_corpus/

# 多码同屏 Demo（评估配套，不入库）
demo/

# 会话目录（2026-09-17 起改为**白名单模式**）：默认忽略全部，只跟踪 memory/
# 理由：该目录是工具会话的工作区 —— 历史上出现过两个"入库的验证脚本"
# （pdf_research_server.py / e2e_kb_zoom_server.py，已迁 tools/dev/），
# 且新增临时产物默认会被跟踪，把"出包 dirty 检查"误判为非干净。
.workbuddy/*
!.workbuddy/memory/
