# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 运行时日志与进程文件
logs/
.server.*
*.log
*.pid

# 管理后台数据与加密密钥（含账号/密码/身份证/大模型密钥，勿提交）
config/admin.json
config/.admin_key

# 插件本地运行配置（含密钥，勿提交）
plugins/character-graph/backend/config.json

# 插件临时产物（轨迹转换视频任务缓存）
plugins/*/backend/.task_cache/

# 共享文档插件运行时数据（用户创建的文档）
plugins/shared-docs/backend/data/

# 战果录入插件运行时数据（本地台账 JSON）与配置（含大模型密钥）
plugins/case-report/backend/data/
plugins/case-report/backend/config.json

# 地图标点插件测试/演示产物（录制视频、模拟轨迹数据）
plugins/map-marker/frontend/*.mp4
plugins/map-marker/frontend/yunfu*.json
plugins/map-marker/frontend/yunfu*.txt
plugins/map-marker/frontend/simulate_yunfu_5min.py

# 编辑器
.vscode/
.idea/
*.swp
.DS_Store

# 环境变量
.env
